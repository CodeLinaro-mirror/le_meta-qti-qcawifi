 include/uapi/linux/nl80211.h |  72 +++++
 net/wireless/ap.c            |  25 +-
 net/wireless/core.c          | 148 ++++++++-
 net/wireless/core.h          |   8 +-
 net/wireless/nl80211.c       | 563 ++++++++++++++++++++++++++++++++++-
 net/wireless/rdev-ops.h      |  19 ++
 net/wireless/sme.c           |   8 +-
 net/wireless/trace.h         |  62 ++++
 net/wireless/util.c          | 164 +++++++++-
 10 files changed, 1209 insertions(+), 23 deletions(-)

