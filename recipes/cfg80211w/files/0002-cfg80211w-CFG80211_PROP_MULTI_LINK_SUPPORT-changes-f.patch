+#endif
 
 	ANDROID_KABI_RESERVE(1);
 };
@@ -1486,6 +1497,9 @@ struct cfg80211_color_change_settings {
  *	the verification
  */
 struct iface_combination_params {
+#ifdef CFG80211_PROP_MULTI_LINK_SUPPORT
+	int radio_idx;
+#endif
 	int num_different_channels;
 	u8 radar_detect;
 	int iftype_num[NUM_NL80211_IFTYPES];
@@ -2948,6 +2962,10 @@ struct cfg80211_auth_request {
  */
 struct cfg80211_assoc_link {
 	struct cfg80211_bss *bss;
+#ifdef CFG80211_PROP_MULTI_LINK_SUPPORT
+	const u8 *bssid;
+	unsigned int freq;
+#endif
 	const u8 *elems;
 	size_t elems_len;
 	bool disabled;
@@ -3253,10 +3271,35 @@ struct cfg80211_connect_params {
 	size_t fils_erp_rrk_len;
 	bool want_1x;
 	struct ieee80211_edmg edmg;
+#ifdef CFG80211_PROP_MULTI_LINK_SUPPORT
+	struct cfg80211_assoc_link links[IEEE80211_MLD_MAX_NUM_LINKS];
+	const u8 *ap_mld_addr;
+	s8 link_id;
+#endif
 
 	ANDROID_KABI_RESERVE(1);
 };
 
+
+#ifdef CFG80211_PROP_MULTI_LINK_SUPPORT
+/**
+ * struct cfg80211_link_reconfig_removal_params - Contains params needed for
+ * link reconfig removal
+ * @link_removal_cntdown: TBTT countdown value until which the beacon with ML
+ *	reconfigure IE will be sent.
+ * @ie: ML reconfigure IE to be updated in beacon in the link going to be
+ *	removed and in all affiliated links.
+ * @ie_len: ML reconfigure IE length
+ * @link_id: Link id of the link to be removed.
+ */
+struct cfg80211_link_reconfig_removal_params {
+	u16 link_removal_cntdown;
+	const u8 *ie;
+	size_t ie_len;
+	unsigned int link_id;
+};
+#endif
+
 /**
  * enum cfg80211_connect_params_changed - Connection parameters being updated
  *
@@ -4827,6 +4870,11 @@ struct cfg80211_ops {
 				    struct cfg80211_set_hw_timestamp *hwts);
 	int	(*set_ttlm)(struct wiphy *wiphy, struct net_device *dev,
 			    struct cfg80211_ttlm_params *params);
+#ifdef CFG80211_PROP_MULTI_LINK_SUPPORT
+	int	(*link_reconfig_remove)(struct wiphy *wiphy,
+		struct net_device *dev,
+		const struct cfg80211_link_reconfig_removal_params *params);
+#endif
 
 	ANDROID_KABI_RESERVE(1);
 	ANDROID_KABI_RESERVE(2);
@@ -5297,6 +5345,40 @@ struct wiphy_iftype_akm_suites {
 	int n_akm_suites;
 };
 
+#ifdef CFG80211_PROP_MULTI_LINK_SUPPORT
+/**
+ * struct wiphy_radio_freq_range - wiphy frequency range
+ * @start_freq:  start range edge frequency (kHz)
+ * @end_freq:    end range edge frequency (kHz)
+ */
+struct wiphy_radio_freq_range {
+	u32 start_freq;
+	u32 end_freq;
+};
+
+
+/**
+ * struct wiphy_radio - physical radio of a wiphy
+ * This structure describes a physical radio belonging to a wiphy.
+ * It is used to describe concurrent-channel capabilities. Only one channel
+ * can be active on the radio described by struct wiphy_radio.
+ *
+ * @freq_range: frequency range that the radio can operate on.
+ * @n_freq_range: number of elements in @freq_range
+ *
+ * @iface_combinations: Valid interface combinations array, should not
+ *	list single interface types.
+ * @n_iface_combinations: number of entries in @iface_combinations array.
+ */
+struct wiphy_radio {
+	const struct wiphy_radio_freq_range *freq_range;
+	int n_freq_range;
+
+	const struct ieee80211_iface_combination *iface_combinations;
+	int n_iface_combinations;
+};
+#endif
+
 #define CFG80211_HW_TIMESTAMP_ALL_PEERS	0xffff
 
 /**
@@ -5665,6 +5747,11 @@ struct wiphy {
 
